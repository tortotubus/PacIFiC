
if(NOT DEFINED XERCESC_SOURCE_DIR)
  message(FATAL_ERROR "XERCESC_SOURCE_DIR must identify the Xerces source tree")
endif()
set(_file "${XERCESC_SOURCE_DIR}/CMakeLists.txt")
file(READ "${_file}" _contents)
set(_old "set(CMAKE_CXX_STANDARD 14)")
set(_new "if(NOT DEFINED CMAKE_CXX_STANDARD)\n  set(CMAKE_CXX_STANDARD 14)\nendif()")
string(FIND "${_contents}" "${_new}" _patched)
if(NOT _patched EQUAL -1)
  return()
endif()
string(FIND "${_contents}" "${_old}" _position)
if(_position EQUAL -1)
  message(FATAL_ERROR
    "Unexpected Xerces CMakeLists.txt: cannot patch its C++14 default. Review patch-cxx-standard.cmake for this Xerces version.")
endif()
string(REPLACE "${_old}" "${_new}" _contents "${_contents}")
file(WRITE "${_file}" "${_contents}")
message(STATUS "Patched Xerces to honor CMAKE_CXX_STANDARD")
