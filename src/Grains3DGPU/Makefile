.PHONY: all libgrainsgpu grainsgpu testsgpu clean

all: libgrainsgpu grainsgpu testsgpu

LIBGRAINS_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Grains
LIBGRAINS_GPU_LIBDIR := $(GRAINS_GPU_LIBDIR)
LIBGRAINS_GPU_OBJDIR := $(GRAINS_GPU_OBJDIR)
LIBGRAINS_GPU_SHAREDIR := $(GRAINS_GPU_SHAREDIR)
LIBGRAINS_GPU_INCDIR := $(GRAINS_GPU_INCDIR)

MAIN_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Main
MAIN_GPU_BINDIR := $(GRAINS_GPU_BINDIR)
TESTS_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Tests
TESTS_GPU_BINDIR := $(GRAINS_GPU_BINDIR)

LIBGRAINS_GPU_MAKE = @$(MAKE) -C $(LIBGRAINS_GPU_SRCDIR) \
  LIBGRAINS_GPU_SRCDIR=$(LIBGRAINS_GPU_SRCDIR) \
  LIBGRAINS_GPU_LIBDIR=$(LIBGRAINS_GPU_LIBDIR) \
  LIBGRAINS_GPU_OBJDIR=$(LIBGRAINS_GPU_OBJDIR) \
  LIBGRAINS_GPU_SHAREDIR=$(LIBGRAINS_GPU_SHAREDIR) \
  LIBGRAINS_GPU_INCDIR=$(LIBGRAINS_GPU_INCDIR) 
  
MAIN_GPU_MAKE = @$(MAKE) -C $(MAIN_GPU_SRCDIR) \
  MAIN_GPU_SRCDIR=$(MAIN_GPU_SRCDIR) \
  MAIN_GPU_BINDIR=$(MAIN_GPU_BINDIR) \
  LIBGRAINS_GPU_SRCDIR=$(LIBGRAINS_GPU_SRCDIR) \
  LIBGRAINS_GPU_LIBDIR=$(LIBGRAINS_GPU_LIBDIR) \
  LIBGRAINS_GPU_OBJDIR=$(LIBGRAINS_GPU_OBJDIR) \
  LIBGRAINS_GPU_INCDIR=$(LIBGRAINS_GPU_INCDIR) 

TESTS_GPU_MAKE = @$(MAKE) -C $(TESTS_GPU_SRCDIR) \
  TEST_GPU_BINDIR=$(TESTS_GPU_BINDIR) \
  LIBGRAINS_GPU_SRCDIR=$(LIBGRAINS_GPU_SRCDIR) \
  LIBGRAINS_GPU_LIBDIR=$(LIBGRAINS_GPU_LIBDIR) \
  LIBGRAINS_GPU_OBJDIR=$(LIBGRAINS_GPU_OBJDIR) \
  LIBGRAINS_GPU_INCDIR=$(LIBGRAINS_GPU_INCDIR)
    
libgrainsgpu:
	$(LIBGRAINS_GPU_MAKE) all

grainsgpu: libgrainsgpu
	$(MAIN_GPU_MAKE) all

testsgpu: libgrainsgpu
	$(TESTS_GPU_MAKE) all
	
clean: 
	$(LIBGRAINS_GPU_MAKE) clean
	$(MAIN_GPU_MAKE) clean
	$(TESTS_GPU_MAKE) clean
